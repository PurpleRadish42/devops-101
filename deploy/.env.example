# Per-environment settings for the VM. Create these in the repo root (/opt/devops-101):
#   cp deploy/.env.example .env.staging
#   cp deploy/.env.example .env.production
# Real .env.* files are gitignored - never commit passwords!

# Staging values (for .env.production use: APP_ENV=production, FRONTEND_PORT=3000)
APP_ENV=staging
FRONTEND_PORT=3001
POSTGRES_PASSWORD=change-me-to-something-long
